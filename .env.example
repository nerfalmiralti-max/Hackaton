OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Optional administrator-managed, read-only NIS materials store.
OPENAI_VECTOR_STORE_ID=
# Optional fixed cookie-signing secret; defaults to a hash of the API key.
SESSION_SECRET=
# Local-only by default. Set an exact origin only behind authenticated hosting.
APP_ORIGIN=http://127.0.0.1:3000
# Optional Microsoft Entra authentication. Keep disabled until the app registration is configured.
NIS_AUTH_ENABLED=false
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional: configure this only when the school tenant ID is confirmed by an administrator.
AUTH_MICROSOFT_ENTRA_TENANT_ID=
NIS_ALLOWED_EMAIL_DOMAIN=akt.nis.edu.kz
