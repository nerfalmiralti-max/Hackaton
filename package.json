{
  "name": "nis-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node --env-file=.env.local scripts/live-smoke.mjs",
    "knowledge:prepare": "node scripts/prepare-knowledge.mjs",
    "knowledge:check": "node scripts/index-knowledge.mjs --dry-run",
    "knowledge:index": "node scripts/index-knowledge.mjs --upload"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "openai": "^6.0.0",
    "zod": "^4.0.0",
    "lucide-react": "^0.577.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.16.28",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.58.0"
  }
